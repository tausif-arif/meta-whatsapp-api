# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Database (local: docker compose up -d)
DATABASE_URL=postgres://meta:meta@localhost:5432/meta_api

# AES-256 key for encrypting stored Meta tokens. Generate: npm run keygen
ENCRYPTION_KEY=

# Agent: inbound WhatsApp messages are POSTed to each tenant's agent_webhook_url
AGENT_TIMEOUT_MS=10000

# Meta credentials — used ONCE by `npm run db:seed` to connect the platform WhatsApp number.
# After seeding, tokens live encrypted in the wa_accounts table (not read at runtime).
META_GRAPH_VERSION=v26.0
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=

# Webhooks (Meta App -> Configuration -> Webhook)
META_VERIFY_TOKEN=
META_APP_SECRET=
